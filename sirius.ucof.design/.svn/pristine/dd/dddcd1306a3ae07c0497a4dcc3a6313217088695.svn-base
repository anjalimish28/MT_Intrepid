                          <subModelOperations xsi:type="tool_1:SetValue" featureName="id" valueExpression="aql: generateUUID()"/>
                          <subModelOperations xsi:type="tool_1:SetValue" featureName="portDirection" valueExpression="aql: enums::PortDirection::In"/>
                        </subModelOperations>
                      </subModelOperations>
                      <subModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql: var:ports">
                        <subModelOperations xsi:type="tool_1:CreateInstance" typeName="ports::SamplingPort" referenceName="port" variableName="port">
                          <subModelOperations xsi:type="tool_1:SetValue" featureName="id" valueExpression="aql: generateUUID()"/>
                          <subModelOperations xsi:type="tool_1:SetValue" featureName="portDirection" valueExpression="aql: enums::PortDirection::Out"/>
                        </subModelOperations>
                      </subModelOperations>
                    </subModelOperations>
                  </subModelOperations>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
