      <additionalLayers name="signalConnectionLayer">
        <nodeMappings name="signal" semanticCandidatesExpression="aql: self.eAllContents()->filter(communication::Signal)" domainClass="communication::Signal">
          <style xsi:type="style:WorkspaceImageDescription" labelSize="12" showIcon="false" sizeComputationExpression="20" resizeKind="NSEW" workspacePath="/sirius.ucof.design/icons/icon_Signal.svg">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
          </style>
