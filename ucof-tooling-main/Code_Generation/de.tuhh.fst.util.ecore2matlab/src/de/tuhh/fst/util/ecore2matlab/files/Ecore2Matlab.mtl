[comment encoding = UTF-8 /]
[module Ecore2Matlab('http://www.eclipse.org/emf/2002/Ecore')/]

[template public Ecore2Matlab(e : EClass)]
	
[comment @main /]
[file ('@'.concat(e.name.concat('/'.concat(e.name.concat('.m')))), false)]

% ======================================================================
%> @brief class [e.name /].
%
%> This class was automatically generated from an ecore model!
