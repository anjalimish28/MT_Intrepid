<?xml version="1.0" encoding="UTF-8"?>
<project default="Ecore2Python" name="de.tuhh.fst.util.ecore2python">
    <property name="ECLIPSE_HOME" value="C:/Tools/eclipse2025_03/eclipse"/>
    <property name="ECLIPSE_WORKSPACE" value="../.."/>

    <!-- The classpath with only the dependencies used by the project -->
    <path id="de.tuhh.fst.util.ecore2python.libraryclasspath">
        <pathelement location="${ECLIPSE_WORKSPACE}/de.tuhh.fst.util.ecore2python/bin"/>
    </path>

    <path id="de.tuhh.fst.util.ecore2python.classpath">
        <path refid="de.tuhh.fst.util.ecore2python.libraryclasspath"/>
    </path>

    <!-- The classpath with only the jars available in the plugin folder of Eclipse -->
    <path id="de.tuhh.fst.util.ecore2python.libraryclasspath.alljars">
        <pathelement location="../de.tuhh.fst.util.ecore2python/bin"/>
        <fileset dir="${ECLIPSE_HOME}/plugins/" includes="*.jar"/>
    </path>

    <path id="de.tuhh.fst.util.ecore2python.classpath.alljars">
        <path refid="de.tuhh.fst.util.ecore2python.libraryclasspath.alljars"/>
    </path>

    <!-- The default task with the jars used by this project -->
    <target name="Ecore2Python">
        <java classname="de.tuhh.fst.util.ecore2pyhton.files.Ecore2Python" classpathref="de.tuhh.fst.util.ecore2python.classpath">
            <arg value="${model}"/>
            <arg value="${target}"/>
        </java>
    </target>

    <!--
        In case of problem you can also try with all the jar available in your Eclipse
        Keep in mind that having two versions of the same jar can create problems
    -->
    <target name="Ecore2Python.alljars">
        <java classname="de.tuhh.fst.util.ecore2pyhton.files.Ecore2Python" classpathref="de.tuhh.fst.util.ecore2python.classpath">
            <arg value="${model}"/>
            <arg value="${target}"/>
        </java>
    </target>
</project>
