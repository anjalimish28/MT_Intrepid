      <metamodel href="https://gitlab.com/ucof/ucof.de/model/v001/ucof#//targetConfiguration/configdesk/dSpaceArinc825"/>
      <metamodel href="https://gitlab.com/ucof/ucof.de/model/v001/ucof#//targetConfiguration/configdesk/ethernet"/>
