          <ownedTools xsi:type="tool:NodeCreationDescription" name="createSamplingPort" nodeMappings="//@ownedViewpoints[name='devices']/@ownedRepresentations[name='Devices%20Diagram']/@defaultLayer/@containerMappings[name='deviceContainer']/@subNodeMappings[name='devicePort']" iconPath="/sirius.ucof.design/icons/icon_SamplingPort.png">
