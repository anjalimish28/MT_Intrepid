  <ownedViewpoints name="devices" modelFileExtension="ucof">
    <ownedRepresentations xsi:type="description_1:DiagramDescription" name="Devices Diagram" domainClass="ucof::Platform" enablePopupBars="true">
      <metamodel href="https://gitlab.com/ucof/ucof.de/model/v001/ucof#/"/>
