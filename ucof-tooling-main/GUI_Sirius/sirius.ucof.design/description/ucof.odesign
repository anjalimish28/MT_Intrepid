      <defaultLayer name="Default">
        <edgeMappings name="SWPortToHWPortContainerLink" sourceMapping="//@ownedViewpoints[name='devices']/@ownedRepresentations[name='Hardware%20Assignment']/@defaultLayer/@containerMappings[name='deviceContainer']/@subNodeMappings[name='devicePort']" targetMapping="//@ownedViewpoints[name='devices']/@ownedRepresentations[name='Hardware%20Assignment']/@defaultLayer/@containerMappings[name='targetContainer']/@subNodeMappings[name='hardwarePort']" targetFinderExpression="aql: self.ancestors()->filter(ucof::Platform)->first().eAllContents() ->filter(targets::SuperHardwarePortType)->select(p | p.id = self.targetID)->first()" sourceFinderExpression="aql: self.ancestors()->filter(ucof::Platform)->first().eAllContents() ->filter(etypes::SuperPortType)->select(p | p.id = self.sourceID)->first()" domainClass="assignments::SWPortToHWPortAssignment" useDomainElement="true">
          <style sizeComputationExpression="2" routingStyle="manhattan">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_yellow']"/>
            <centerLabelStyleDescription labelSize="12">
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_red']"/>
            </centerLabelStyleDescription>
          </style>
