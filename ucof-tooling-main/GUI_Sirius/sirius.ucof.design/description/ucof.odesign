      <metamodel href="https://gitlab.com/ucof/ucof.de/model/v001/ucof#//targetConfiguration/configECIC/packageStrategyTypes"/>
      <metamodel href="https://gitlab.com/ucof/ucof.de/model/v001/ucof#//targetConfiguration/configECIC/streamTypes"/>
