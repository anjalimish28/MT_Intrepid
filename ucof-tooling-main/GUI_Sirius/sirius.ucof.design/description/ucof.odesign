      <metamodel href="https://gitlab.com/ucof/ucof.de/model/v001/ucof#//targetConfiguration/vxworksa653"/>
      <metamodel href="https://gitlab.com/ucof/ucof.de/model/v001/ucof#//targetConfiguration/configdesk/wired"/>
      <defaultLayer name="Default">
        <edgeMappings name="PortToPortContainerLink" sourceMapping="//@ownedViewpoints[name='devices']/@ownedRepresentations[name='Devices%20Diagram']/@defaultLayer/@containerMappings[name='deviceContainer']/@subNodeMappings[name='devicePort']" targetMapping="//@ownedViewpoints[name='devices']/@ownedRepresentations[name='Devices%20Diagram']/@defaultLayer/@containerMappings[name='deviceContainer']/@subNodeMappings[name='devicePort']" targetFinderExpression="aql: self.ancestors()->filter(ucof::Platform)->first().eAllContents() ->filter(etypes::SuperPortType)->select(p | p.id = self.targetID)->first()" sourceFinderExpression="aql: self.ancestors()->filter(ucof::Platform)->first().eAllContents() ->filter(etypes::SuperPortType)->select(p | p.id = self.sourceID)->first()" domainClass="assignments::PortToPortAssignment" useDomainElement="true">
          <style sizeComputationExpression="2" routingStyle="manhattan">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_yellow']"/>
            <centerLabelStyleDescription labelSize="12">
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_red']"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
        <containerMappings name="deviceContainer" semanticCandidatesExpression="aql:self.eAllContents()->filter(etypes::SuperDeviceType)" domainClass="etypes::SuperDeviceType">
          <subNodeMappings name="devicePort" semanticCandidatesExpression="aql: self.ports.port" domainClass="etypes::SuperPortType">
            <style xsi:type="style:WorkspaceImageDescription" labelSize="12" sizeComputationExpression="-1" resizeKind="NSEW" workspacePath="/sirius.ucof.design/icons/icon_SamplingPort.svg">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </style>
            <conditionnalStyles predicateExpression="aql: self.portDirection = enums::PortDirectionType::In">
              <style xsi:type="style:WorkspaceImageDescription" labelSize="12" sizeComputationExpression="2" resizeKind="NSEW" workspacePath="/sirius.ucof.design/icons/icon_Inport.svg">
                <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
                <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              </style>
            </conditionnalStyles>
            <conditionnalStyles predicateExpression="aql: self.portDirection = enums::PortDirectionType::Out">
              <style xsi:type="style:WorkspaceImageDescription" labelSize="12" sizeComputationExpression="2" resizeKind="NSEW" workspacePath="/sirius.ucof.design/icons/icon_Outport.svg">
                <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
                <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              </style>
            </conditionnalStyles>
          </subNodeMappings>
          <conditionnalStyles predicateExpression="aql: self.eClass().name = 'A664Switch'">
            <style xsi:type="style:WorkspaceImageDescription" labelSize="30" showIcon="false" sizeComputationExpression="" workspacePath="/sirius.ucof.design/icons/icon_Switch.svg">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <labelFormat>bold</labelFormat>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </style>
          </conditionnalStyles>
          <conditionnalStyles predicateExpression="aql: self.eClass().name = 'Peripheral' and self.peripheralType = 'Fan'">
            <style xsi:type="style:WorkspaceImageDescription" labelSize="30" showIcon="false" workspacePath="/sirius.ucof.design/icons/icon_FAN.svg">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <labelFormat>bold</labelFormat>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </style>
          </conditionnalStyles>
          <conditionnalStyles predicateExpression="aql: self.eClass().name = 'Peripheral' and self.peripheralType = 'CAV'">
            <style xsi:type="style:WorkspaceImageDescription" labelSize="30" showIcon="false" workspacePath="/sirius.ucof.design/icons/icon_CAV.svg">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <labelFormat>bold</labelFormat>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </style>
          </conditionnalStyles>
          <conditionnalStyles predicateExpression="aql: self.eClass().name = 'A653P1Module'">
            <style xsi:type="style:WorkspaceImageDescription" labelSize="30" showIcon="false" workspacePath="/sirius.ucof.design/icons/icon_CPIOM.svg">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <labelFormat>bold</labelFormat>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </style>
          </conditionnalStyles>
          <conditionnalStyles predicateExpression="aql: self.eClass().name = 'A653P4Module'">
            <style xsi:type="style:WorkspaceImageDescription" labelSize="30" showIcon="false" workspacePath="/sirius.ucof.design/icons/icon_CPIOM.svg">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <labelFormat>bold</labelFormat>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </style>
          </conditionnalStyles>
          <conditionnalStyles predicateExpression="aql: self.eClass().name = 'IOModule'">
            <style xsi:type="style:WorkspaceImageDescription" labelSize="30" showIcon="false" workspacePath="/sirius.ucof.design/icons/icon_IOM.svg">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <labelFormat>bold</labelFormat>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </style>
          </conditionnalStyles>
          <conditionnalStyles predicateExpression="aql: self.eClass().name = 'ED247Gateway'">
            <style xsi:type="style:WorkspaceImageDescription" labelSize="30" showIcon="false" workspacePath="/sirius.ucof.design/icons/icon_Gateway.svg">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <labelFormat>bold</labelFormat>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </style>
          </conditionnalStyles>
          <conditionnalStyles predicateExpression="aql: self.eClass().name = 'Peripheral' and self.peripheralType = 'Sensor'">
            <style xsi:type="style:WorkspaceImageDescription" labelSize="20" showIcon="false" workspacePath="/sirius.ucof.design/icons/Sensor.svg">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
              <labelFormat>bold</labelFormat>
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </style>
          </conditionnalStyles>
        </containerMappings>
        <toolSections name="Tool Section">
          <ownedTools xsi:type="tool:EdgeCreationDescription" name="portToPortEdgeCreator" forceRefresh="true" edgeMappings="//@ownedViewpoints[name='devices']/@ownedRepresentations[name='Devices%20Diagram']/@defaultLayer/@edgeMappings[name='PortToPortContainerLink']">
            <sourceVariable name="source"/>
            <targetVariable name="target"/>
            <sourceViewVariable name="sourceView"/>
            <targetViewVariable name="targetView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql: self.ancestors()->filter(ucof::Platform)->first().eAllContents() ->filter(assignments::PortToPortAssignmentSet)->first()">
                <subModelOperations xsi:type="tool_1:CreateInstance" typeName="assignments::PortToPortAssignment" referenceName="portToPortAssignment" variableName="newAssignment">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="sourceID" valueExpression="aql:source.id"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="targetID" valueExpression="aql:target.id"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="id" valueExpression="aql: generateUUID()"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql: source.name + '_TO_' + target.name"/>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:ContainerCreationDescription" name="createIOModule" containerMappings="//@ownedViewpoints[name='devices']/@ownedRepresentations[name='Devices%20Diagram']/@defaultLayer/@containerMappings[name='deviceContainer']" iconPath="/sirius.ucof.design/icons/icon_IOM.png">
            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql: self.devices">
                <subModelOperations xsi:type="tool_1:CreateInstance" typeName="devicetypes::IOModule" referenceName="device" variableName="newDevice">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="id" valueExpression="aql: generateUUID()"/>
                  <subModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql: var:newDevice">
                    <subModelOperations xsi:type="tool_1:CreateInstance" typeName="etypes::DevicePorts" referenceName="ports" variableName="ports">
                      <subModelOperations xsi:type="tool_1:SetValue" featureName="id" valueExpression="aql: generateUUID()"/>
                      <subModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql: var:ports">
                        <subModelOperations xsi:type="tool_1:CreateInstance" typeName="etypes::SamplingPort" referenceName="port" variableName="port">
                          <subModelOperations xsi:type="tool_1:SetValue" featureName="id" valueExpression="aql: generateUUID()"/>
                          <subModelOperations xsi:type="tool_1:SetValue" featureName="portDirection" valueExpression="aql: enums::PortDirectionType::In"/>
                        </subModelOperations>
                      </subModelOperations>
                      <subModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql: var:ports">
                        <subModelOperations xsi:type="tool_1:CreateInstance" typeName="etypes::SamplingPort" referenceName="port" variableName="port">
                          <subModelOperations xsi:type="tool_1:SetValue" featureName="id" valueExpression="aql: generateUUID()"/>
                          <subModelOperations xsi:type="tool_1:SetValue" featureName="portDirection" valueExpression="aql: enums::PortDirectionType::Out"/>
                        </subModelOperations>
                      </subModelOperations>
                    </subModelOperations>
                  </subModelOperations>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:ContainerCreationDescription" name="createSwitch" containerMappings="//@ownedViewpoints[name='devices']/@ownedRepresentations[name='Devices%20Diagram']/@defaultLayer/@containerMappings[name='deviceContainer']" iconPath="/sirius.ucof.design/icons/icon_Switch.png">
            <variable name="container"/>
            <viewVariable name="containerView"/>
