          eType="#//powergrid/PowerConnection" containment="true"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="PowerConnection" eSuperTypes="ucof.ecore#//assignments/SuperAssignmentType">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="resistance" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="ElectricalPowerGridSet" eSuperTypes="ucof.ecore#//common/etypes/SuperIdentifierType ucof.ecore#//common/etypes/SuperTrackingType">
      <eStructuralFeatures xsi:type="ecore:EReference" name="electricalGrid" upperBound="-1"
          eType="#//powergrid/SuperElectricalGridType" containment="true"/>
    </eClassifiers>
  </eSubpackages>
