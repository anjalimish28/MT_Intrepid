  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SuperClassExtensionType" abstract="true"
      eSuperTypes="ucof.ecore#//common/etypes/SuperIdentifierType ucof.ecore#//common/etypes/SuperTrackingType">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="extendedClassID" eType="ecore:EDataType ucof.ecore#//common/edata/UUIDType"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SuperAssignmentSpecificationType" abstract="true"
      eSuperTypes="ucof.ecore#//common/etypes/SuperIdentifierType ucof.ecore#//common/etypes/SuperTrackingType">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="referencedAssignmentID"
