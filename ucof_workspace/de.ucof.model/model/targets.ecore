  <eSubpackages name="powergrid" nsURI="https://gitlab.com/ucof/ucof.de/model/v001/ucof/targets/powergrid"
      nsPrefix="de.ucof.model.targets.powergrid">
    <eClassifiers xsi:type="ecore:EClass" name="SuperPowerType" abstract="true">
      <eStructuralFeatures xsi:type="ecore:EReference" name="electricalInterfaces"
          eType="#//powergrid/EletrcialInterfaces" containment="true"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="EletrcialInterfaces" eSuperTypes="ucof.ecore#//common/etypes/SuperIdentifierType ucof.ecore#//common/etypes/SuperTrackingType">
      <eStructuralFeatures xsi:type="ecore:EReference" name="electricalInterface"
          upperBound="-1" eType="#//powergrid/SuperElectricalInterfaceType" containment="true"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="SuperElectricalInterfaceType" abstract="true"
        eSuperTypes="ucof.ecore#//common/etypes/SuperIdentifierType ucof.ecore#//common/etypes/SuperTrackingType">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="minVoltage" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="maxVoltage" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="type" eType="#//powergrid/interfaceType"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EEnum" name="interfaceType">
      <eLiterals name="NotSet"/>
      <eLiterals name="sink" value="1"/>
      <eLiterals name="source" value="2"/>
      <eLiterals name="sinkSource" value="3"/>
      <eLiterals name="analogReference" value="4"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="SuperElectricalGridType" abstract="true"
        eSuperTypes="ucof.ecore#//common/etypes/SuperIdentifierType ucof.ecore#//common/etypes/SuperTrackingType">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="definedVoltage" eType="ecore:EEnum ucof.ecore#//common/enums/booleanType"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="nominalVoltage" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EEnum" name="gridType">
      <eLiterals name="NotSet"/>
      <eLiterals name="Supply" value="1"/>
      <eLiterals name="Ground" value="2"/>
      <eLiterals name="analogReference" value="3"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="PowerConnectionSet" eSuperTypes="ucof.ecore#//common/etypes/SuperIdentifierType ucof.ecore#//common/etypes/SuperTrackingType">
