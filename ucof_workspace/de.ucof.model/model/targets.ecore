<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="targets" nsURI="https://gitlab.com/ucof/ucof.de/model/v001/ucof/targets"
    nsPrefix="de.ucof.model.targets">
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="generateModelWizard" value="false"/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EClass" name="Targets" eSuperTypes="ucof.ecore#//common/etypes/SuperIdentifierType ucof.ecore#//common/etypes/SuperTrackingType">
    <eStructuralFeatures xsi:type="ecore:EReference" name="targetConfiguration" upperBound="-1"
        eType="#//SuperTargetType" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="powerConnectionSet" upperBound="-1"
        eType="#//powergrid/PowerConnectionSet" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="electricalPowerGridSet"
        upperBound="-1" eType="#//powergrid/ElectricalPowerGridSet" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SuperTargetType" abstract="true" eSuperTypes="ucof.ecore#//common/etypes/SuperIdentifierType ucof.ecore#//common/etypes/SuperTrackingType">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="projectName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SuperIOHardwareType" abstract="true"
