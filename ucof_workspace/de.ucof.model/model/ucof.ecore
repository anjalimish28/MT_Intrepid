          eSuperTypes="#//common/etypes/SuperIdentifierType #//common/etypes/SuperTrackingType">
        <eStructuralFeatures xsi:type="ecore:EReference" name="functionLink" eType="#//devices/functions/FunctionLink"
            containment="true"/>
      </eClassifiers>
      <eSubpackages name="routing" nsURI="https://gitlab.com/ucof/ucof.de/model/v001/ucof/Functions/Routing"
          nsPrefix="de.ucof.model.devices.functions.routing">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="generateModelWizard" value="false"/>
          <details key="documentation" value="Container for routing function implementation >> easy to implement logic that can be transformed to code during integration"/>
