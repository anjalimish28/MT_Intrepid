<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="ucof" nsURI="https://gitlab.com/ucof/ucof.de/model/v001/ucof"
    nsPrefix="de.ucof.model">
  <eClassifiers xsi:type="ecore:EClass" name="Platform" eSuperTypes="#//common/etypes/SuperIdentifierType #//common/etypes/SuperTrackingType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Top level object"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="devices" eType="#//devices/Devices"
        containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Container for all Devices/Modules (layer 2)"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="communication" eType="#//communication/Communication"
        containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Container for Network Elements (layer 2)"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="assignments" eType="#//assignments/Assignments"
        containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Container for Assignment Elements (layer 2)"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="targets" eType="ecore:EClass targets.ecore#//Targets"
        containment="true"/>
  </eClassifiers>
  <eSubpackages name="common" nsURI="https://gitlab.com/ucof/ucof.de/model/v001/ucof/common"
      nsPrefix="de.ucof.model.common">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Container, including commonly used Types, Enums and Data-Definitions"/>
      <details key="generateModelWizard" value="false"/>
    </eAnnotations>
    <eSubpackages name="enums" nsURI="https://gitlab.com/ucof/ucof.de/model/v001/ucof/common/enums"
        nsPrefix="de.ucof.model.common.enums">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Container, including commonly used Enums"/>
        <details key="generateModelWizard" value="false"/>
      </eAnnotations>
      <eClassifiers xsi:type="ecore:EEnum" name="booleanType">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Definition for boolen type with true/false. Has &quot;NotSet&quot; as default for deterministic behaviour"/>
        </eAnnotations>
        <eLiterals name="NotSet"/>
        <eLiterals name="true" value="1"/>
        <eLiterals name="false" value="2"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EEnum" name="TargetDataType">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Target Data Type for transformations. Can be extended with more potential data types."/>
        </eAnnotations>
        <eLiterals name="NotSet"/>
        <eLiterals name="String" value="1"/>
        <eLiterals name="UInt8" value="2" literal="UInt8"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EEnum" name="MemoryAccessType">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Memory Acces Type, primarily used for A653 Operating Systems, can be employed for all memory acces options"/>
        </eAnnotations>
        <eLiterals name="NotSet"/>
        <eLiterals name="Read" value="1"/>
        <eLiterals name="ReadWrite" value="2"/>
        <eLiterals name="Write" value="3" literal="Write"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EEnum" name="MemoryType">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Definition for Memory Types primarily used for A653 operating systems"/>
        </eAnnotations>
        <eLiterals name="NotSet"/>
        <eLiterals name="Volatile" value="1"/>
        <eLiterals name="NonVolatile" value="2"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EEnum" name="PortDirectionType">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Port Direction setting with bidirectional setting possible (InOut) for  e.g., A825/CAN"/>
        </eAnnotations>
        <eLiterals name="NotSet"/>
        <eLiterals name="In" value="1" literal="In"/>
        <eLiterals name="Out" value="2" literal="Out"/>
        <eLiterals name="InOut" value="3"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EEnum" name="SingleDirectionType">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Port Direction setting with bidirectional setting impossible "/>
        </eAnnotations>
        <eLiterals name="NotSet"/>
        <eLiterals name="In" value="1" literal="In"/>
        <eLiterals name="Out" value="2" literal="Out"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EEnum" name="YesNoType">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="&quot;Yes&quot; or &quot;No&quot; setting, with &quot;NotSet&quot; as default"/>
        </eAnnotations>
        <eLiterals name="NotSet"/>
        <eLiterals name="No" value="1"/>
        <eLiterals name="Yes" value="2"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EEnum" name="SDITypes">
        <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
          <details key="name" value="SDITypes"/>
        </eAnnotations>
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="SDI Types for ARINC429 interface setting"/>
        </eAnnotations>
        <eLiterals name="NotSet" literal="NotSet"/>
        <eLiterals name="ZERO" value="1" literal="ZERO"/>
        <eLiterals name="ONE" value="2" literal="ONE"/>
        <eLiterals name="TWO" value="3" literal="TWO"/>
        <eLiterals name="THREE" value="4" literal="THREE"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EEnum" name="ImplementationType">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Implementation type for devices, virtual is simulation, hardware is an emulation or real hardware"/>
        </eAnnotations>
        <eLiterals name="NotSet"/>
        <eLiterals name="Virtual" value="1"/>
        <eLiterals name="Hardware" value="2"/>
      </eClassifiers>
    </eSubpackages>
    <eSubpackages name="etypes" nsURI="https://gitlab.com/ucof/ucof.de/model/v001/ucof/common/etypes"
        nsPrefix="de.ucof.model.common.etypes">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="generateModelWizard" value="false"/>
        <details key="documentation" value="Container, including commonly used eTypes"/>
      </eAnnotations>
      <eClassifiers xsi:type="ecore:EClass" name="SuperIdentifierType" abstract="true">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Super Class used in every class for setting identifier (UUID format) and name "/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1"
            eType="#//common/edata/UUIDType" iD="true">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="A global unique identifier string for every model element. This id is used as a reference between model elements"/>
            <details key="propertyCategory" value="Identifiers"/>
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="#//common/edata/NameType">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="A string for the name of the element as shown in textual or graphical representations of the model"/>
            <details key="propertyCategory" value="Identifiers"/>
          </eAnnotations>
        </eStructuralFeatures>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="SuperTrackingType" abstract="true">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Super Class for traceability attributes, i.e. creation and modification info"/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="documentation" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
            defaultValueLiteral="">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="A textual documentation of this model element"/>
            <details key="propertyCategory" value="Tracing"/>
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="modified" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="The date of the last modification. This should be set automatically."/>
            <details key="propertyCategory" value="Tracing"/>
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="modifier" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="The name of the user who last modified the element."/>
            <details key="propertyCategory" value="Tracing"/>
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="traceLink" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
            defaultValueLiteral="">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="A textual traceable link. For instance the requirement id."/>
            <details key="propertyCategory" value="Tracing"/>
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="created" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="propertyCategory" value="Tracing"/>
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="creator" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="propertyCategory" value="Tracing"/>
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="version" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="propertyCategory" value="Tracing"/>
          </eAnnotations>
        </eStructuralFeatures>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="SuperSetType" abstract="true" eSuperTypes="#//common/etypes/SuperIdentifierType #//common/etypes/SuperTrackingType">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Super type for sets, sets can be used for grouping a large number of objects"/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="setname" upperBound="-1"
            eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="Memory" eSuperTypes="#//common/etypes/SuperIdentifierType #//common/etypes/SuperTrackingType">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Memory Type, primarily used in A653 Operating Systems"/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EReference" name="memoryRequirements"
            upperBound="-1" eType="#//common/etypes/MemoryRequirement" containment="true"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="MemoryRequirement" eSuperTypes="#//common/etypes/SuperIdentifierType #//common/etypes/SuperTrackingType">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Memory Requirements Type i.e., defining memory parameters, primarily used in A653 Operating Systems"/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="access" eType="#//common/enums/MemoryAccessType"/>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="memoryType" eType="#//common/enums/MemoryType"/>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="size" eType="#//common/edata/DecOrHexValueType"/>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="address" eType="#//common/edata/HexAddressType"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="SuperDeviceType" abstract="true"
          eSuperTypes="#//common/etypes/SuperIdentifierType #//common/etypes/SuperTrackingType">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Abstract general device type"/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="configurationLink"
            eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Externally linked configuration possible, should be avoided though"/>
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EReference" name="ports" eType="#//common/etypes/DevicePorts"
            containment="true">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="I/O with which device communicates with other devices"/>
          </eAnnotations>
        </eStructuralFeatures>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="SuperPortType" abstract="true" eSuperTypes="#//common/etypes/SuperIdentifierType #//common/etypes/SuperTrackingType">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Super port type, used for all port elements"/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="maxMessageSize" eType="#//common/edata/DecOrHexValueType">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="The maximum message size for the port in bytes."/>
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="portDirection" eType="#//common/enums/PortDirectionType">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="The direction of informationflow from/to port"/>
          </eAnnotations>
        </eStructuralFeatures>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="DevicePorts" eSuperTypes="#//common/etypes/SuperTrackingType #//common/etypes/SuperIdentifierType">
        <eStructuralFeatures xsi:type="ecore:EReference" name="port" upperBound="1024"
            eType="#//common/etypes/SuperInterCommunicationPortType" containment="true"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="SuperInterCommunicationPortType"
          abstract="true" eSuperTypes="#//common/etypes/SuperPortType">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Super Type for all ports on device and partition level"/>
        </eAnnotations>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="SamplingPort" eSuperTypes="#//common/etypes/SuperInterCommunicationPortType">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Sampling Port where new messages overwrite old entries. Always only holds one message"/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="refreshPeriodORTransmissionRate"
            eType="#//common/edata/DecOrHexValueType">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Allows O/S to control whether correct messages arrive at a specified rate in the port, regardless of receive request rate"/>
          </eAnnotations>
        </eStructuralFeatures>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="QueuingPort" eSuperTypes="#//common/etypes/SuperInterCommunicationPortType">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Queuing Port with First in First Out principle. Can hold as many messages as specified in attribute MaxNumberOfMessages"/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="maxNumberOfMessages"
            eType="#//common/edata/DecOrHexValueType">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="How many messages can be stored in Port"/>
          </eAnnotations>
        </eStructuralFeatures>
      </eClassifiers>
    </eSubpackages>
    <eSubpackages name="edata" nsURI="https://gitlab.com/ucof/ucof.de/model/v001/ucof/common/edata"
        nsPrefix="de.ucof.model.common.edata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Container, includes commonly used data definitions"/>
      </eAnnotations>
      <eClassifiers xsi:type="ecore:EDataType" name="DecOrHexValueType" instanceClassName="java.lang.String">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="A653: Allows hex and decimal numbers. Hex start 0x"/>
        </eAnnotations>
        <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
          <details key="name" value="DEC_OR_HEX_VALUE_TYPE"/>
          <details key="baseType" value="http://www.eclipse.org/emf/2003/XMLType#string"/>
          <details key="pattern" value="([+-]{0,1}[0-9]+|[+-]{0,1}0x[0-9a-fA-F]+)?"/>
        </eAnnotations>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EDataType" name="HexAddressType" instanceClassName="java.lang.String">
        <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
          <details key="name" value="HexAddressType"/>
          <details key="baseType" value="http://www.eclipse.org/emf/2003/XMLType#string"/>
          <details key="pattern" value="0x[0-9A-Fa-f]+|[0-9]+"/>
        </eAnnotations>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EDataType" name="IdentifierValueType" instanceClassName="java.lang.String">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="A653/RCE/RPC: Restricts identifiers to hex or decimal numbers."/>
        </eAnnotations>
        <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
          <details key="name" value="IDENTIFIER_VALUE_TYPE"/>
          <details key="baseType" value="http://www.eclipse.org/emf/2003/XMLType#string"/>
          <details key="pattern" value="[+-]{0,1}[0-9]+|[+-]{0,1}0x[0-9a-fA-F]+"/>
        </eAnnotations>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EDataType" name="UUIDType" instanceClassName="java.lang.String">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="for UUIDs"/>
        </eAnnotations>
        <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
          <details key="name" value="UUID_TYPE"/>
          <details key="baseType" value="http://www.eclipse.org/emf/2003/XMLType#string"/>
          <details key="pattern" value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"/>
        </eAnnotations>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EDataType" name="IPAddressType" instanceClassName="java.lang.String">
        <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
          <details key="name" value="IP_ADDRESS_TYPE"/>
          <details key="baseType" value="http://www.eclipse.org/emf/2003/XMLType#string"/>
          <details key="pattern" value="(([^.])|([0-9]{1,3}\.){3}[0-9]{1,3})?"/>
        </eAnnotations>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EDataType" name="NameType" instanceClassName="java.lang.String">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="A653: A 1..30 character string."/>
        </eAnnotations>
        <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
          <details key="name" value="NAME_TYPE"/>
          <details key="baseType" value="http://www.eclipse.org/emf/2003/XMLType#string"/>
          <details key="minLength" value="1"/>
          <details key="maxLength" value="30"/>
        </eAnnotations>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EDataType" name="PortType" instanceClassName="java.lang.Integer">
        <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
          <details key="name" value="PORT_TYPE"/>
          <details key="baseType" value="http://www.eclipse.org/emf/2003/XMLType#int:Object"/>
          <details key="minInclusive" value="0"/>
          <details key="maxInclusive" value="65535"/>
        </eAnnotations>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EDataType" name="PositiveIntType" instanceClassName="java.lang.Integer">
        <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
          <details key="name" value="POSITIVE_INTEGER_TYPE"/>
          <details key="baseType" value="http://www.eclipse.org/emf/2003/XMLType#int:Object"/>
          <details key="minInclusive" value="0"/>
        </eAnnotations>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EDataType" name="MACAddressType" instanceClassName="java.lang.String">
        <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
          <details key="name" value="MAC_ADDRESS_TYPE"/>
          <details key="baseType" value="http://www.eclipse.org/emf/2003/XMLType#string"/>
          <details key="pattern" value="[0-9A-Fa-f]{2}:[0-9A-Fa-f]{2}:[0-9A-Fa-f]{2}:[0-9A-Fa-f]{2}:[0-9A-Fa-f]{2}:[0-9A-Fa-f]{2}"/>
        </eAnnotations>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EDataType" name="EtherType" instanceClassName="java.lang.String">
        <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
          <details key="name" value="ETHER_TYPE"/>
          <details key="baseType" value="http://www.eclipse.org/emf/2003/XMLType#string"/>
          <details key="pattern" value="0x[0-9A-Fa-f]{4}"/>
        </eAnnotations>
      </eClassifiers>
    </eSubpackages>
  </eSubpackages>
  <eSubpackages name="devices" nsURI="https://gitlab.com/ucof/ucof.de/model/v001/ucof/devices"
      nsPrefix="de.ucof.model.devices">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="generateModelWizard" value="false"/>
      <details key="documentation" value="Contains all information regarding device configuration. Implementation of this configuration can be either virtual or hardware-based, depending on target systems."/>
    </eAnnotations>
    <eClassifiers xsi:type="ecore:EClass" name="Devices" eSuperTypes="#//common/etypes/SuperTrackingType #//common/etypes/SuperIdentifierType">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Container for devices"/>
      </eAnnotations>
      <eStructuralFeatures xsi:type="ecore:EReference" name="device" upperBound="-1"
          eType="#//devices/SuperPlatformDeviceType" containment="true"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="SuperPlatformDeviceType" abstract="true"
        eSuperTypes="#//common/etypes/SuperDeviceType">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Abstract general device type"/>
      </eAnnotations>
      <eStructuralFeatures xsi:type="ecore:EReference" name="deviceFunctions" eType="#//devices/functions/DeviceFunctions"
          containment="true">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
