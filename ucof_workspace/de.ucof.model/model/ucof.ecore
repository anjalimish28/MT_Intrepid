          </eClassifiers>
          <eClassifiers xsi:type="ecore:EEnum" name="ModuleRecoveryActions">
            <eLiterals name="NotSet"/>
            <eLiterals name="Ignore" value="1"/>
            <eLiterals name="ShutdownModule" value="2"/>
            <eLiterals name="ResetModule" value="3"/>
            <eLiterals name="Custom" value="4"/>
          </eClassifiers>
          <eClassifiers xsi:type="ecore:EClass" name="PartitionRecoveryAction" eSuperTypes="#//devices/devicetypes/a653components/healthmanagement/PartitionProcessLevelAction #//devices/devicetypes/a653components/healthmanagement/ModulePartitionLevelAction">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
              <details key="documentation" value="Container for Partition Recovery Action"/>
            </eAnnotations>
            <eStructuralFeatures xsi:type="ecore:EAttribute" name="recoveryAction"
                eType="#//devices/devicetypes/a653components/healthmanagement/PartitionRecoveryActions">
              <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="Recovery action to take when error level is PARTITION or when Error Handler is not created (IGNORE, IDLE, WARM_RESTART, COLD_RESTART)."/>
              </eAnnotations>
            </eStructuralFeatures>
          </eClassifiers>
          <eClassifiers xsi:type="ecore:EEnum" name="PartitionRecoveryActions">
            <eLiterals name="NotSet"/>
            <eLiterals name="Ignore" value="1"/>
            <eLiterals name="Idle" value="2"/>
            <eLiterals name="WarmRestart" value="3"/>
            <eLiterals name="ColdRestart" value="4"/>
          </eClassifiers>
          <eClassifiers xsi:type="ecore:EClass" name="ProcessRevoceryAction" eSuperTypes="#//devices/devicetypes/a653components/healthmanagement/PartitionProcessLevelAction">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
              <details key="documentation" value="Container for Process Recovery Action"/>
            </eAnnotations>
            <eStructuralFeatures xsi:type="ecore:EAttribute" name="errorCode" eType="#//devices/devicetypes/a653components/healthmanagement/ErrorCode">
              <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="Error code to be provided to Error Handler process (DEADLINE_MISSED, APPLICATION_ERROR, NUMERIC_ERROR, ILLEGAL_REQUEST, STACK_OVERFLOW, MEMORY_VIOLATION, HARDWARE_FAULT, POWER_FAIL)"/>
              </eAnnotations>
            </eStructuralFeatures>
            <eStructuralFeatures xsi:type="ecore:EAttribute" name="recoveryAction"
                eType="#//devices/devicetypes/a653components/healthmanagement/ProcessRecoveryActions"/>
          </eClassifiers>
          <eClassifiers xsi:type="ecore:EEnum" name="ProcessRecoveryActions">
            <eLiterals name="NotSet"/>
            <eLiterals name="IgnoreAndLog" value="1"/>
            <eLiterals name="IgnoreNTimesBeforeAction" value="2"/>
            <eLiterals name="StopAndReinitializeFromEntryAddress" value="3"/>
            <eLiterals name="StopProcessAndStartOtherProcess" value="4"/>
            <eLiterals name="StopProcess" value="5"/>
            <eLiterals name="PartitionColdRestart" value="6"/>
            <eLiterals name="PartitionWarmRestart" value="7"/>
            <eLiterals name="PartitionSetIdle" value="8"/>
          </eClassifiers>
        </eSubpackages>
      </eSubpackages>
