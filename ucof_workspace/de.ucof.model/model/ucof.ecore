        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="generateModelWizard" value="false"/>
          <details key="documentation" value="Container, including all elements necessary for creating packet strategies in ECIC"/>
        </eAnnotations>
        <eClassifiers xsi:type="ecore:EClass" name="SuperPacketStrategyType" abstract="true"
            eSuperTypes="#//common/etypes/SuperIdentifierType #//common/etypes/SuperTrackingType">
          <eStructuralFeatures xsi:type="ecore:EAttribute" name="PeriodNs" eType="#//common/edata/PositiveIntType"
              defaultValueLiteral="0"/>
        </eClassifiers>
        <eClassifiers xsi:type="ecore:EClass" name="A429PacketStrategy" eSuperTypes="#//communication/configECIC/packageStrategyTypes/SuperPacketStrategyType">
          <eStructuralFeatures xsi:type="ecore:EAttribute" name="Direction" eType="#//common/enums/SingleDirectionType"/>
          <eStructuralFeatures xsi:type="ecore:EReference" name="Gap" eType="#//communication/configECIC/packageStrategyTypes/Gap"
              containment="true"/>
          <eStructuralFeatures xsi:type="ecore:EReference" name="TriggerWords" upperBound="-1"
              eType="#//communication/configECIC/packageStrategyTypes/TriggerWords"
              containment="true"/>
        </eClassifiers>
        <eClassifiers xsi:type="ecore:EClass" name="A825PacketStrategy" eSuperTypes="#//communication/configECIC/packageStrategyTypes/SuperPacketStrategyType">
          <eStructuralFeatures xsi:type="ecore:EReference" name="Frames" eType="#//communication/configECIC/packageStrategyTypes/Frames"
              containment="true"/>
        </eClassifiers>
        <eClassifiers xsi:type="ecore:EClass" name="A664PacketStrategy" eSuperTypes="#//communication/configECIC/packageStrategyTypes/SuperPacketStrategyType"/>
        <eClassifiers xsi:type="ecore:EClass" name="ETHPacketStrategy" eSuperTypes="#//communication/configECIC/packageStrategyTypes/SuperPacketStrategyType"/>
        <eClassifiers xsi:type="ecore:EClass" name="DISPacketStrategy" eSuperTypes="#//communication/configECIC/packageStrategyTypes/SuperPacketStrategyType">
          <eStructuralFeatures xsi:type="ecore:EAttribute" name="ResetPeriodicTimer"
              eType="#//common/enums/YesNoType"/>
        </eClassifiers>
        <eClassifiers xsi:type="ecore:EClass" name="ANAPacketStrategy" eSuperTypes="#//communication/configECIC/packageStrategyTypes/SuperPacketStrategyType"/>
        <eClassifiers xsi:type="ecore:EClass" name="NADPacketStrategy" eSuperTypes="#//communication/configECIC/packageStrategyTypes/SuperPacketStrategyType"/>
        <eClassifiers xsi:type="ecore:EClass" name="Gap" eSuperTypes="#//common/etypes/SuperIdentifierType #//common/etypes/SuperTrackingType">
          <eStructuralFeatures xsi:type="ecore:EAttribute" name="DurationNs" eType="#//common/edata/PositiveIntType"/>
          <eStructuralFeatures xsi:type="ecore:EAttribute" name="ResetPeriodicTimer"
              eType="#//common/enums/YesNoType"/>
        </eClassifiers>
        <eClassifiers xsi:type="ecore:EClass" name="TriggerWords" eSuperTypes="#//common/etypes/SuperIdentifierType #//common/etypes/SuperTrackingType">
          <eStructuralFeatures xsi:type="ecore:EReference" name="TriggerWord" upperBound="-1"
              eType="#//communication/configECIC/packageStrategyTypes/TriggerWord"
              containment="true"/>
        </eClassifiers>
        <eClassifiers xsi:type="ecore:EClass" name="TriggerWord" eSuperTypes="#//common/etypes/SuperIdentifierType #//common/etypes/SuperTrackingType">
          <eStructuralFeatures xsi:type="ecore:EAttribute" name="Label" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
          <eStructuralFeatures xsi:type="ecore:EAttribute" name="SDI" eType="#//common/enums/SDITypes"/>
          <eStructuralFeatures xsi:type="ecore:EAttribute" name="ResetPeriodicTimer"
              eType="#//common/enums/YesNoType"/>
        </eClassifiers>
        <eClassifiers xsi:type="ecore:EClass" name="Frame" eSuperTypes="#//common/etypes/SuperIdentifierType #//common/etypes/SuperTrackingType">
          <eStructuralFeatures xsi:type="ecore:EAttribute" name="A825ID" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
          <eStructuralFeatures xsi:type="ecore:EAttribute" name="ResetPeriodicTimer"
              eType="#//common/enums/YesNoType"/>
        </eClassifiers>
        <eClassifiers xsi:type="ecore:EClass" name="LLC" eSuperTypes="#//common/etypes/SuperIdentifierType #//common/etypes/SuperTrackingType">
          <eStructuralFeatures xsi:type="ecore:EAttribute" name="LLC" eType="#//communication/configECIC/packageStrategyTypes/LLCType"/>
          <eStructuralFeatures xsi:type="ecore:EAttribute" name="ResetPeriodicTimer"
              eType="#//common/enums/YesNoType"/>
        </eClassifiers>
        <eClassifiers xsi:type="ecore:EEnum" name="LLCType">
          <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
            <details key="name" value="SDITypes"/>
          </eAnnotations>
          <eLiterals name="NotSet" literal="NotSet"/>
          <eLiterals name="ZERO" value="1" literal="ZERO"/>
          <eLiterals name="ONE" value="2" literal="ONE"/>
          <eLiterals name="TWO" value="3" literal="TWO"/>
          <eLiterals name="THREE" value="4" literal="THREE"/>
          <eLiterals name="FOUR" value="5" literal="FOUR"/>
          <eLiterals name="FIVE" value="6" literal="FIVE"/>
          <eLiterals name="SIX" value="7" literal="SIX"/>
          <eLiterals name="SEVEN" value="8" literal="SEVEN"/>
        </eClassifiers>
        <eClassifiers xsi:type="ecore:EClass" name="Frames" eSuperTypes="#//common/etypes/SuperIdentifierType #//common/etypes/SuperTrackingType">
          <eStructuralFeatures xsi:type="ecore:EReference" name="Frame" eType="#//communication/configECIC/packageStrategyTypes/Frame"
              containment="true"/>
          <eStructuralFeatures xsi:type="ecore:EReference" name="LLC" eType="#//communication/configECIC/packageStrategyTypes/LLC"
              containment="true"/>
        </eClassifiers>
      </eSubpackages>
    </eSubpackages>
    <eSubpackages name="comDevices" nsURI="https://gitlab.com/ucof/ucof.de/model/v001/ucof/communication/comDevices"
        nsPrefix="de.ucof.model.communication.comDevices">
      <eClassifiers xsi:type="ecore:EClass" name="CommunicationDevices" eSuperTypes="#//common/etypes/SuperSetType">
        <eStructuralFeatures xsi:type="ecore:EReference" name="communicationDevice"
            upperBound="-1" eType="#//communication/comDevices/SuperCommunicationDeviceType"
            containment="true"/>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="SuperCommunicationDeviceType" abstract="true"
          eSuperTypes="#//common/etypes/SuperDeviceType"/>
      <eClassifiers xsi:type="ecore:EClass" name="ED247Gateway" eSuperTypes="#//communication/comDevices/SuperCommunicationDeviceType"/>
      <eClassifiers xsi:type="ecore:EClass" name="GenericGateway" eSuperTypes="#//communication/comDevices/SuperCommunicationDeviceType"/>
    </eSubpackages>
    <eSubpackages name="i2c" nsURI="https://gitlab.com/ucof/ucof.de/model/v001/ucof/communication/i2c"
        nsPrefix="de.ucof.model.communication.i2c">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="generateModelWizard" value="false"/>
        <details key="documentation" value="Container for I2C (Inter-Integrated Circuit) bus interface elements. Based on NXP UM10204 Rev. 7.0 (1 October 2021). I2C is a synchronous, bidirectional, half-duplex serial bus using two lines: SDA (serial data) and SCL (serial clock). Rev. 7.0 updated terminology: 'master' is now 'controller', 'slave' is now 'target'. Reference: https://www.nxp.com/docs/en/user-guide/UM10204.pdf"/>
      </eAnnotations>
      <eClassifiers xsi:type="ecore:EEnum" name="I2CBusMode">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="I2C bus speed mode as defined in UM10204 Rev.7.0, Section 5. Standard/Fast/FastModePlus/HighSpeed are bidirectional (open-drain). UltraFast is unidirectional push-pull (WRITE only, no ACK)."/>
        </eAnnotations>
        <eLiterals name="NotSet"/>
        <eLiterals name="Standard" value="1" literal="Standard_100kbps">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Standard-mode (Sm): up to 100 kbit/s. UM10204 Section 3.1."/>
          </eAnnotations>
        </eLiterals>
        <eLiterals name="FastMode" value="2" literal="FastMode_400kbps">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Fast-mode (Fm): up to 400 kbit/s. Downward-compatible with Sm. UM10204 Section 5.1."/>
          </eAnnotations>
        </eLiterals>
        <eLiterals name="FastModePlus" value="3" literal="FastModePlus_1Mbps">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Fast-mode Plus (Fm+): up to 1 Mbit/s. Increased drive strength x10. UM10204 Section 5.2."/>
          </eAnnotations>
        </eLiterals>
        <eLiterals name="HighSpeed" value="4" literal="HighSpeed_3400kbps">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="High-speed mode (Hs-mode): up to 3.4 Mbit/s. Requires Hs-mode controller code. UM10204 Section 5.3."/>
          </eAnnotations>
        </eLiterals>
        <eLiterals name="UltraFast" value="5" literal="UltraFast_5Mbps">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Ultra Fast-mode (UFm): up to 5 Mbit/s. UNIDIRECTIONAL (write only). Uses push-pull drivers on USDA/USCL (not open-drain). ACK/NACK not used. Not compatible with Sm/Fm/Fm+/Hs. I2CMessage.direction MUST be Out when this mode is selected. UM10204 Section 3.2."/>
          </eAnnotations>
        </eLiterals>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EEnum" name="I2CAddressMode">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Target address width. UM10204 Rev.7.0, Sections 3.1.10 and 3.1.11. 7-bit is mandatory for all modes; 10-bit is optional. Devices with both address widths can co-exist on the same bus."/>
        </eAnnotations>
        <eLiterals name="NotSet"/>
        <eLiterals name="Bit7" value="1">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="7-bit addressing (mandatory). 128 total addresses. Two reserved groups: 0000 XXX and 1111 XXX (Table 4). 112 usable addresses. UM10204 Section 3.1.10."/>
          </eAnnotations>
        </eLiterals>
        <eLiterals name="Bit10" value="2">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="10-bit addressing (optional). First byte prefix: 1111 0XX. Not widely used. UM10204 Section 3.1.11. Not supported in UFm read operations."/>
          </eAnnotations>
        </eLiterals>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="I2CBus" eSuperTypes="#//communication/SuperCommunicationInterfaceType">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="I2C bus interface. Two wires: SDA (serial data) and SCL (serial clock). Open-drain bidirectional (except UltraFast which is push-pull).  All connected devices share the same SDA and SCL lines. UM10204 Rev.7.0 Section 3.1."/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="busMode" eType="#//communication/i2c/I2CBusMode">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Operating speed mode of the bus. UM10204 Section 5.  Standard (100k), Fast (400k), FastModePlus (1M), HighSpeed (3.4M), UltraFast (5M, write-only).  ADS1115 maximum: FastMode (400 kbps)."/>
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="addressMode" eType="#//communication/i2c/I2CAddressMode">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Target address width on this bus. UM10204 Sections 3.1.10-3.1.11."/>
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="pullUpResistanceOhm"
            eType="#//common/edata/PositiveIntType">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Pull-up resistor value in Ohms for SDA and SCL lines. UM10204 Section 3.1.1: both SDA and SCL require one pull-up resistor per line (not per device) connected to VDD. Typical values: 1000-10000 Ohms.  Higher resistance: slower rise time, lower max speed. Lower resistance: faster communication, higher power consumption. For FastMode (400kbps): recommend 2200-4700 Ohms."/>
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="clockStretchingEnabled"
            eType="#//common/enums/booleanType">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Whether clock stretching is used on this bus. UM10204 Section 3.1.9: a target may hold SCL LOW to force the controller into a wait state until the target is ready. This is optional; not all targets implement it. Not possible in UltraFast mode."/>
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="multiControllerEnabled"
            eType="#//common/enums/booleanType">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Whether multiple controllers share this bus. UM10204 Section 3.1.8: arbitration procedure prevents data corruption when two controllers simultaneously try to control the bus. Must be false for UltraFast mode (Section 3.2, p.22): push-pull outputs cause bus contention with multiple controllers. Typical embedded use (single MCU as controller): false."/>
          </eAnnotations>
        </eStructuralFeatures>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="I2CMessage" eSuperTypes="#//communication/SuperMessageType">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="One I2C transaction: [START][target address + R/W bit][data bytes][STOP]. UM10204 Rev.7.0, Section 3.1.10, Figure 9. "/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="targetAddress" eType="#//common/edata/IdentifierValueType">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="I2C target (slave) address. UM10204 Section 3.1.10.  For 7-bit mode: values 0x00-0x7F (0000 XXX and 1111 XXX are reserved).  For 10-bit mode: first byte prefix is 1111 0XX."/>
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="direction" eType="#//common/enums/SingleDirectionType">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Transaction direction (R/W bit). UM10204 Section 3.1.10.  Out (WRITE, R/W=0): controller sends data bytes to target. In  (READ,  R/W=1): controller receives data bytes from target. In UltraFast mode: ONLY Out is valid (unidirectional bus, Section 3.2). "/>
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="dataLengthBytes" eType="#//common/edata/PositiveIntType">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Number of data bytes in the data phase of this transaction. UM10204 Section 3.1.5: unrestricted number of bytes,  each followed by an ACK/NACK bit."/>
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="repeatedStart" eType="#//common/enums/booleanType">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Whether this transaction uses a Repeated START (Sr) condition.  UM10204 Section 3.1.10, Figure 13 (Combined format). When true: transaction is [S][addr+W][register pointer][Sr][addr+R][data][P].  This models a combined write-pointer-then-read, which is the standard method for reading a specific register from an I2C target.  When false: transaction ends with a STOP condition after the data phase. Not applicable to UltraFast mode."/>
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="registerPointerByte"
            eType="#//common/edata/DecOrHexValueType">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Internal register pointer byte written to the target before a repeated START.  Only relevant when repeatedStart=true. UM10204 Figure 13: in a combined format transaction, the controller  first writes this byte (the register sub-address) then issues Sr and reads the register content. "/>
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EReference" name="registerSpecification"
            eType="#//communication/i2c/I2CRegisterSpecification" containment="true">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Optional register-level specification for the target register  accessed by this transaction. Used for driver code generation and documentation. Contains register name, width, default value."/>
          </eAnnotations>
        </eStructuralFeatures>
      </eClassifiers>
      <eClassifiers xsi:type="ecore:EClass" name="I2CRegisterSpecification" eSuperTypes="#//common/etypes/SuperIdentifierType #//common/etypes/SuperTrackingType">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="Describes an internal register of an I2C target device. &#xA;"/>
        </eAnnotations>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="registerName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Human-readable name of the register as per the device datasheet. "/>
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="registerPointerAddress"
            eType="#//common/edata/DecOrHexValueType">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Internal register pointer address (the byte written to the target to select which register to read/write). "/>
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="registerWidthBits"
            eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Width of the register in bits. UM10204 Section 3.1.5: data is always transferred MSB first in 8-bit bytes. Multi-byte registers use consecutive byte transfers."/>
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="defaultValue" eType="#//common/edata/DecOrHexValueType">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Power-on reset / default value of the register.  From the I2C target device datasheet, not from UM10204."/>
          </eAnnotations>
        </eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="readOnly" eType="#//common/enums/booleanType">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Whether this register is read-only from the controller's perspective. ADS1115 Conversion register (0x00): readOnly = true (ADC result)."/>
          </eAnnotations>
        </eStructuralFeatures>
      </eClassifiers>
    </eSubpackages>
  </eSubpackages>
  <eSubpackages name="assignments" nsURI="https://gitlab.com/ucof/ucof.de/model/v001/ucof/assignments"
      nsPrefix="de.ucof.model.assignments">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="generateModelWizard" value="false"/>
      <details key="documentation" value="Container, including all assingment elements, i.e. assignments are class based relationships. These help in keeping the model flexible, because relationships are more dynamic"/>
    </eAnnotations>
    <eClassifiers xsi:type="ecore:EClass" name="Assignments" eSuperTypes="#//common/etypes/SuperIdentifierType #//common/etypes/SuperTrackingType">
      <eStructuralFeatures xsi:type="ecore:EReference" name="assignmentSet" upperBound="-1"
          eType="#//assignments/SuperAssignmentSetType" containment="true"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="SuperAssignmentSetType" abstract="true"
        eSuperTypes="#//common/etypes/SuperSetType"/>
    <eClassifiers xsi:type="ecore:EClass" name="SuperAssignmentType" abstract="true"
        eSuperTypes="#//common/etypes/SuperIdentifierType #//common/etypes/SuperTrackingType">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Super type for each assignment >> Has the core sourceID and targetID attribute. The sourceID is assigned to the targetID"/>
      </eAnnotations>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="sourceID" eType="#//common/edata/UUIDType"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="targetID" eType="#//common/edata/UUIDType"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="InterfaceToPort2PortAssignmentSet"
        eSuperTypes="#//assignments/SuperAssignmentSetType">
      <eStructuralFeatures xsi:type="ecore:EReference" name="interfaceToPortAssignment"
          upperBound="-1" eType="#//assignments/InterfaceToPort2PortAssignment" containment="true"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="InterfaceToPort2PortAssignment" eSuperTypes="#//assignments/SuperAssignmentType"/>
    <eClassifiers xsi:type="ecore:EClass" name="DeviceToImplementationAssignmentSet"
        eSuperTypes="#//assignments/SuperAssignmentSetType">
      <eStructuralFeatures xsi:type="ecore:EReference" name="deviceToImplementationAssignment"
          upperBound="-1" eType="#//assignments/DeviceToImplementationAssignment"
          containment="true"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="DeviceToImplementationAssignment"
        eSuperTypes="#//assignments/SuperAssignmentType"/>
    <eClassifiers xsi:type="ecore:EClass" name="InterfaceToHardwareAssignmentSet"
        eSuperTypes="#//assignments/SuperAssignmentSetType">
      <eStructuralFeatures xsi:type="ecore:EReference" name="interfaceToHardwareAssignment"
          upperBound="-1" eType="#//assignments/InterfaceToHardwareAssignment" containment="true"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="InterfaceToHardwareAssignment" eSuperTypes="#//assignments/SuperAssignmentType"/>
    <eClassifiers xsi:type="ecore:EClass" name="PortToPortAssignmentSet" eSuperTypes="#//assignments/SuperAssignmentSetType">
      <eStructuralFeatures xsi:type="ecore:EReference" name="portToPortAssignment"
          upperBound="-1" eType="#//assignments/PortToPortAssignment" containment="true"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="PortToPortAssignment" eSuperTypes="#//assignments/SuperAssignmentType">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Central assignment. Essentially is the connection between two ports. Signals/Payload/Messages can be assigned to this connection for information on which data is transmitted"/>
      </eAnnotations>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="transmissionRate" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="refreshRate" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="ED247AssignmentSet" eSuperTypes="#//assignments/SuperAssignmentSetType">
      <eStructuralFeatures xsi:type="ecore:EReference" name="ed247Assignment" upperBound="-1"
          eType="#//assignments/ED247Assignment" containment="true"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="ED247Assignment" eSuperTypes="#//assignments/SuperAssignmentType">
      <eStructuralFeatures xsi:type="ecore:EReference" name="udpSocketExtension" upperBound="2"
          eType="#//assignments/UDPSocketExtension" containment="true"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="UDPSocketExtension" eSuperTypes="#//common/etypes/SuperIdentifierType #//common/etypes/SuperTrackingType">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="portSelection" eType="#//common/enums/SingleDirectionType"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="ipAdress" eType="#//common/edata/IPAddressType"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="port" eType="#//common/edata/PortType"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="SWPortToHWPortAssignmentSet" eSuperTypes="#//assignments/SuperAssignmentSetType">
      <eStructuralFeatures xsi:type="ecore:EReference" name="swPortToHWPortAssignment"
