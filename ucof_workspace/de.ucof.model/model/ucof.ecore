              <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
                <details key="documentation" value="Description of the state."/>
              </eAnnotations>
            </eStructuralFeatures>
            <eStructuralFeatures xsi:type="ecore:EReference" name="errorInfo" upperBound="-1"
                eType="#//devices/devicetypes/a653components/healthmanagement/ErrorInfoModule"
                containment="true"/>
          </eClassifiers>
          <eClassifiers xsi:type="ecore:EClass" name="MultiPartitionTables" eSuperTypes="#//common/etypes/SuperIdentifierType #//common/etypes/SuperTrackingType">
