      <eSubpackages name="a653components" nsURI="https://gitlab.com/ucof/ucof.de/model/v001/ucof/devices/devicetypes/a653components"
          nsPrefix="de.ucof.model.a653components">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="generateModelWizard" value="false"/>
          <details key="documentation" value="Container, including specific ARINC 653 configuration parameters"/>
        </eAnnotations>
        <eClassifiers xsi:type="ecore:EClass" name="ModuleSchedule" eSuperTypes="#//common/etypes/SuperIdentifierType #//common/etypes/SuperTrackingType">
          <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
            <details key="documentation" value="Container for the schedule elements"/>
          </eAnnotations>
          <eStructuralFeatures xsi:type="ecore:EReference" name="partitionTimeWindow"
              upperBound="-1" eType="#//devices/devicetypes/a653components/PartitionTimeWindow"
