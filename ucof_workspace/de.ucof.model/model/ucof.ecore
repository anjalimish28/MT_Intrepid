            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
              <details key="documentation" value="Abstract class so that only one action can be selected according to error level. Done via SuperType"/>
            </eAnnotations>
          </eClassifiers>
          <eClassifiers xsi:type="ecore:EClass" name="PartitionProcessLevelAction"
              abstract="true" eSuperTypes="#//common/etypes/SuperIdentifierType #//common/etypes/SuperTrackingType">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
              <details key="documentation" value="Abstract class so that only one action can be selected according to error level. Done via SuperType"/>
            </eAnnotations>
          </eClassifiers>
          <eClassifiers xsi:type="ecore:EClass" name="ModuleRecoveryAction" eSuperTypes="#//devices/devicetypes/a653components/healthmanagement/ModulePartitionLevelAction">
            <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
              <details key="documentation" value="Container for Module Recovery Action"/>
            </eAnnotations>
            <eStructuralFeatures xsi:type="ecore:EAttribute" name="recoveryAction"
